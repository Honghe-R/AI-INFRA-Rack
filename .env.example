# Local development environment.
#
#   cp .env.example .env
#
# `.env` is ignored by git. The dev scripts read it — `npm run dev:api`, `start:api`,
# `migrate`, `dev:seed`, `dev:up` and friends — and the Vite dev server reads it for the
# token bridge. Anything already exported in your shell takes precedence, so a one-off
# `DATABASE_URL=... npm run migrate` still behaves as you would expect.
#
# `npm run dev:up` starts the services these values point at and prints the same block.

# --- database -----------------------------------------------------------------------
# Matches the `db` service in compose.yaml. Host port 55432 rather than 5432 so a locally
# installed PostgreSQL does not collide.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/facility
# Optional: pool size per process (default 10) and statement timeout in ms (default 30000).
# DATABASE_POOL_MAX=10
# DATABASE_STATEMENT_TIMEOUT_MS=30000

# --- object storage -----------------------------------------------------------------
# An S3-compatible store, which is what the deployment uses too. Locally that is MinIO in
# compose.yaml; in deployment it is a bucket, and only these values change.
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=http://127.0.0.1:59000
STORAGE_BUCKET=ai-infra-assets
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=ai-infra
STORAGE_SECRET_ACCESS_KEY=ai-infra-secret
# Path-style addressing is required by a local store. Leave unset against real S3.
# STORAGE_FORCE_PATH_STYLE=true
# Offline alternative with no container runtime. It cannot mint download URLs, so the
# download flow needs the S3 driver.
# STORAGE_DRIVER=filesystem
# STORAGE_ROOT=/tmp/ai-infra-objects

# --- authentication -----------------------------------------------------------------
# The shell has no sign-in surface yet, so the Vite dev server mints a development token
# and the API verifies it. The value must be IDENTICAL in both terminals: the API falls
# back to a different well-known secret when this is unset, and every request is then a 401.
AUTH_DEV_SECRET=dev-secret-for-local-only
AUTH_ISSUER=https://identity.local
# Deployment uses an OIDC issuer instead; the shared secret is refused in production.
# AUTH_JWKS_URI=https://<issuer>/.well-known/jwks.json
# AUTH_AUDIENCE=<api-identifier>

# --- application --------------------------------------------------------------------
NODE_ENV=development
PORT=8787
LOG_LEVEL=info
# The Vite dev server proxies /api to this origin.
API_URL=http://127.0.0.1:8787
# Left unset for local development: the dev server is the origin the shell is served from.
# CORS_ORIGIN=http://localhost:5173

# --- assistant (LLM backend) ---------------------------------------------------------
# The server owns provider selection: a request never names a provider, and the key is a
# secret NAME resolved through the secrets provider, never a value in this file. With no
# LLM_ENDPOINT the assistant endpoints are unavailable (503) and the rest of the API runs.
# LLM_PROVIDER=openai-compatible
# LLM_ENDPOINT=https://<gateway>/v1/chat/completions
# LLM_MODEL=<model-name>
# The models a caller may choose between, comma-separated. Unset means no choice: the
# deployment runs LLM_MODEL and the composer shows no selector. A model named by a request
# is honoured only if it appears here, so a client can pick within this menu but can never
# widen it — the endpoint and the credential stay server-side.
#
# The values are the `id` fields the gateway returns from `GET /api/v1/models`, never the
# model name typed into an application form: the two are not the same, and only the id is
# a valid call parameter. Several ids are aliases for one model, so listing both offers it
# twice. As documented for the SJTU gateway (claw.sjtu.edu.cn/guide/sjtu-api):
#
#   id                  model                       params  context  suited to
#   deepseek-chat       DeepSeek V4 Flash, standard   284B    512k    general text
#   deepseek-reasoner   DeepSeek V4 Flash, thinking   284B    512k    complex reasoning
#   minimax             MiniMax-M2.7                  230B    192k    agent tasks
#   minimax-m2.7        alias of minimax
#   qwen                Qwen3.8-27B                    27B    256k    vision and text
#   qwen3.8-27b         alias of qwen
#
# Four models, six ids. Listing the aliases as well gives a menu that looks like six
# choices and is really four.
# LLM_MODELS=deepseek-chat,deepseek-reasoner,minimax,qwen
# LLM_API_KEY_SECRET=LLM_API_KEY
# LLM_TIMEOUT_MS=60000
# A gateway that authenticates by network position needs no bearer key.
# LLM_ALLOW_NO_KEY=false
# Turn budgets and the per-turn context bounds (chatbox blueprint section 4.3).
# ASSISTANT_MAX_ITERATIONS=8
# ASSISTANT_MAX_MESSAGES=60
# ASSISTANT_MAX_INPUT_BYTES=200000
# ASSISTANT_RESULT_BYTES=32768
# ASSISTANT_DIGEST_BYTES=8192
# Monthly token quotas; unset means unlimited. The assistant records usage per scope and
# reports the caller's own total, which spans every scope they spent in.
# ASSISTANT_USER_MONTHLY_TOKENS=
# ASSISTANT_WORKSPACE_MONTHLY_TOKENS=
# ASSISTANT_ORGANISATION_MONTHLY_TOKENS=

# --- basemap providers -----------------------------------------------------------------
# The public OpenStreetMap tile server needs no credential, but its usage policy requires
# an identifying User-Agent and an accurate Referer, forbids prefetch and offline use, and
# requires a cache of at least seven days (the proxy's default for this provider is exactly
# that). Set these to name YOUR deployment before serving it to anyone.
# MAP_OSM_USER_AGENT=your-app/1.0 (+https://your-site.example; contact: ops@your-site.example)
# MAP_OSM_REFERER=https://your-site.example
# A licensed alternative, and the SLA-backed one: set the key and pick the provider in the UI.
# MAP_GOOGLE_API_KEY=
# MAP_OSM_API_KEY=
# For a local map with no licence at all: run `npm run dev:tiles` in another terminal and
# set the address it serves on. The provider is registered ONLY when this is set — with no
# self-hosted tile server there is nothing to point at, and an option that fails on every
# tile reads as a broken canvas rather than an unconfigured one.
# MAP_SELF_HOSTED_TILE_URL=http://127.0.0.1:8080/tiles/{z}/{x}/{y}.png
