<?xml version="1.0" encoding="UTF-8"?>
<!-- Small KML 2.2 conformance fixture for the kml adapter. -->
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Sample site</name>
    <Style id="siteStyle">
      <IconStyle><scale>1.2</scale></IconStyle>
    </Style>
    <StyleMap id="siteStyleMap">
      <Pair><key>normal</key><styleUrl>#siteStyle</styleUrl></Pair>
    </StyleMap>
    <Folder>
      <name>Site</name>
      <Placemark>
        <name>Yard</name>
        <styleUrl>#siteStyle</styleUrl>
        <ExtendedData>
          <Data name="use"><value>utility</value></Data>
          <Data name="capacity_mw"><value><![CDATA[120 & up]]></value></Data>
        </ExtendedData>
        <Point>
          <altitudeMode>absolute</altitudeMode>
          <coordinates>-122.4194,37.7749,12.5</coordinates>
        </Point>
      </Placemark>
      <Folder>
        <name>Parcels</name>
        <Placemark>
          <name>P-1</name>
          <ExtendedData>
            <Data name="apn"><value>001-002</value></Data>
          </ExtendedData>
          <Polygon>
            <outerBoundaryIs>
              <LinearRing>
                <coordinates>
                  -122.4200,37.7700,0 -122.4100,37.7700,0 -122.4100,37.7800,0
                  -122.4200,37.7800,0 -122.4200,37.7700,0
                </coordinates>
              </LinearRing>
            </outerBoundaryIs>
            <innerBoundaryIs>
              <LinearRing>
                <coordinates>
                  -122.4180,37.7730,0 -122.4170,37.7730,0 -122.4170,37.7740,0
                  -122.4180,37.7740,0 -122.4180,37.7730,0
                </coordinates>
              </LinearRing>
            </innerBoundaryIs>
          </Polygon>
        </Placemark>
      </Folder>
    </Folder>
    <Placemark>
      <name>Route</name>
      <LineString>
        <coordinates>-122.4300,37.7600,5 -122.4200,37.7500,6</coordinates>
      </LineString>
    </Placemark>
    <Placemark>
      <name>Substation</name>
      <Point><coordinates>-122.4000,37.7900</coordinates></Point>
    </Placemark>
    <NetworkLink>
      <name>Remote feed</name>
      <Link><href>https://example.com/feed.kml</href></Link>
    </NetworkLink>
  </Document>
</kml>
