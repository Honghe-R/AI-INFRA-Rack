# Template for npm run rack:setup. Generated .env is local and ignored by Git.
AI_INFRA_COMPOSE_FILE=compose.rack.yaml
COMPOSE_PROJECT_NAME=ai-infra-rack-dev
AI_INFRA_DB_PORT=55532
POSTGRES_USER=rack_dev
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=rack_facility
DATABASE_URL=postgres://rack_dev:CHANGE_ME_DB_PASSWORD@127.0.0.1:55532/rack_facility

AI_INFRA_OBJECT_STORE_PORT=59100
AI_INFRA_OBJECT_STORE_CONSOLE_PORT=59101
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=http://127.0.0.1:59100
STORAGE_BUCKET=rack-dev-assets
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=rack-local
STORAGE_SECRET_ACCESS_KEY=CHANGE_ME_STORAGE_SECRET
STORAGE_FORCE_PATH_STYLE=true

NODE_ENV=development
AUTH_DEV_SECRET=CHANGE_ME_AUTH_SECRET
AUTH_ISSUER=https://identity.local
HOST=127.0.0.1
PORT=8797
WEB_PORT=5193
API_URL=http://127.0.0.1:8797
LOG_LEVEL=info

# Offline demo grid tiles, generated locally; no external map requests required.
AI_INFRA_LOCAL_TILES=true
TILE_PORT=8088
MAP_SELF_HOSTED_TILE_URL=http://127.0.0.1:8088/tiles/{z}/{x}/{y}.png
# Assistant remains unavailable until an LLM provider is explicitly configured.
